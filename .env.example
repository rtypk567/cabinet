# Секрет для подписи сессий (минимум 32 символа). Сгенерировать: openssl rand -base64 48
# Для запуска `npm run dev` можно не задавать, для production обязателен.
SESSION_SECRET=

# Токен бота от @BotFather (формат 123456789:AA...). Имя бота приложение определяет само.
# Токен хранится только на сервере, в браузер он не попадает. Никому его не показывайте.
TELEGRAM_BOT_TOKEN=

# Необязательно: указать имя бота вручную (без @), если не хотите, чтобы сервер спрашивал его у Telegram.
# TELEGRAM_BOT_USERNAME=

# Путь к файлу базы SQLite (по умолчанию ./data/app.db)
DATABASE_PATH=./data/app.db

# Необязательно: путь к вашему логотипу из /public, например /logo.svg
NEXT_PUBLIC_LOGO_SRC=

# Необязательно: принудительно включить/выключить Secure у cookie (по умолчанию включено в production).
# Для проверки `next start` по http://localhost поставьте false.
COOKIE_SECURE=

# Вход по номеру телефона. Пока подключён только тестовый канал "console": код печатается
# в окне терминала, где запущен `npm run dev`. В production вкладка «Телефон» скрыта,
# пока не подключён реальный канал доставки (см. src/lib/sms.ts).
# PHONE_PROVIDER=console
